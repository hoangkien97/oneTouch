@page "{userId:int}"
@model OneTouch.Pages.MedicalRecordManager.IndexModel

@{
    ViewData["Title"] = "Lịch sử bệnh án";
}



<div class="container mt-4">
    <h2 class="text-primary mb-4">📋 Lịch Sử Bệnh Án - @Model.PatientName</h2>

    @if (!Model.MedicalRecords.Any())
    {
        <div class="alert alert-info">Không có bệnh án nào.</div>
    }
    else
    {
        <table class="table table-bordered shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>🗓 Ngày tạo</th>
                    <th>🧾 Chẩn đoán</th>
                    <th>📝 Ghi chú bác sĩ</th>
                    <th>👨‍⚕️ Bác sĩ</th>
                    <th>🏥 Chuyên ngành</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model.MedicalRecords)
                {
                    var doctor = record.Appointment?.Schedule?.Doctor;
                    <tr>
                        <td>@record.CreatedAt?.ToString("dd/MM/yyyy")</td>
                        <td>@record.Diagnosis</td>
                        <td>@record.DoctorNote</td>
                        <td>@doctor?.User?.FullName</td>
                        <td>@doctor?.Specialty?.Name</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a asp-page="/DoctorManager/PatientForDoctorManager"
       asp-route-doctorId="@Model.MedicalRecords.FirstOrDefault()?.Appointment?.Schedule?.DoctorId"
       class="btn btn-secondary mt-3">
        ⬅️ Quay lại danh sách bệnh nhân
    </a>
</div>