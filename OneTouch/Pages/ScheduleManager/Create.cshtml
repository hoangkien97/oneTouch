@page
@model OneTouch.Pages.ScheduleManager.CreateModel

@{
    ViewData["Title"] = "Create Schedule";
}

<h1 class="mt-4">Create New Schedule</h1>
<hr />

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Schedule.DoctorId" class="form-label">Doctor</label>
                        <select asp-for="Schedule.DoctorId" class="form-select" asp-items="ViewBag.Doctor">
                            <option value="">-- Select Doctor --</option>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Schedule.Date" class="form-label">Date</label>
                        <input asp-for="Schedule.Date" class="form-control" type="date" />
                        <span asp-validation-for="Schedule.Date" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Schedule.StartTime" class="form-label">Start Time</label>
                        <input asp-for="Schedule.StartTime" class="form-control" type="time" />
                        <span asp-validation-for="Schedule.StartTime" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Schedule.EndTime" class="form-label">End Time</label>
                        <input asp-for="Schedule.EndTime" class="form-control" type="time" />
                        <span asp-validation-for="Schedule.EndTime" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Schedule.MaxPatients" class="form-label">Max Patients</label>
                        <input asp-for="Schedule.MaxPatients" class="form-control" />
                        <span asp-validation-for="Schedule.MaxPatients" class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">Create Schedule</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="mt-3 text-center">
            <a asp-page="Index" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
