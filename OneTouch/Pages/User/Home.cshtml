@page
@model OneTouch.Pages.User.HomeModel
@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Hero Section -->
<section class="hero-section position-relative text-white py-5 mb-4" style="min-height: 320px; background: linear-gradient(90deg, #0d6efd 60%, #6c63ff 100%);">
    <div class="container position-relative py-4" style="z-index: 2;">
        <div class="row align-items-center">
            <div class="col-lg-8 animate-fadeInUp">
                <span class="badge bg-warning mb-3 px-3 py-2">Chào mừng trở lại!</span>
                <h1 class="display-5 fw-bold mb-3">Xin chào, @Model.UserName</h1>
                <p class="lead mb-4">Chúc bạn một ngày tốt lành cùng OneTouch Medical. Đặt lịch, quản lý sức khỏe và nhận tư vấn dễ dàng!</p>
                <a href="/Appointments/Create" class="btn btn-light btn-lg shadow">Đặt lịch khám ngay</a>
            </div>
        </div>
    </div>
    <div class="overlay" style="background: rgba(0,0,0,0.2); position: absolute; top:0; left:0; width:100%; height:100%; z-index:1;"></div>
</section>

<!-- Quick Actions -->
<section class="py-2">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-3">
                <div class="feature-card text-center shadow-hover h-100">
                    <div class="feature-icon mx-auto mb-3"><i class="fas fa-calendar-plus"></i></div>
                    <h3 class="h5 mb-2">Đặt lịch khám</h3>
                    <p class="text-muted mb-3">Đặt lịch với bác sĩ chuyên khoa</p>
                    <a href="/Appointments/Create" class="btn btn-primary">Đặt lịch</a>
                </div>
            </div>
            <div class="col-md-3">
                <div class="feature-card text-center shadow-hover h-100">
                    <div class="feature-icon mx-auto mb-3"><i class="fas fa-history"></i></div>
                    <h3 class="h5 mb-2">Lịch sử khám</h3>
                    <p class="text-muted mb-3">Xem lại lịch sử khám bệnh</p>
                    <a href="/Appointments/History" class="btn btn-primary">Xem lịch sử</a>
                </div>
            </div>
            <div class="col-md-3">
                <div class="feature-card text-center shadow-hover h-100">
                    <div class="feature-icon mx-auto mb-3"><i class="fas fa-user"></i></div>
                    <h3 class="h5 mb-2">Hồ sơ cá nhân</h3>
                    <p class="text-muted mb-3">Cập nhật thông tin cá nhân</p>
                    <a href="/Profile" class="btn btn-primary">Cập nhật</a>
                </div>
            </div>
            <div class="col-md-3">
                <div class="feature-card text-center shadow-hover h-100">
                    <div class="feature-icon mx-auto mb-3"><i class="fas fa-star"></i></div>
                    <h3 class="h5 mb-2">Đánh giá & Góp ý</h3>
                    <p class="text-muted mb-3">Gửi nhận xét cho dịch vụ</p>
                    <a href="/Appointments/History" class="btn btn-primary">Đánh giá ngay</a>
                </div>
            </div>
        </div>
    </div>
</section>

