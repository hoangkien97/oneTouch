@page
@model OneTouch.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <h2 class="mb-4 text-center">Quên mật khẩu</h2>
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success">@Model.SuccessMessage</div>
            }
            <form method="post">
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input asp-for="Input.Email" class="form-control" id="email" type="email" required />
                </div>
                <button type="submit" class="btn btn-primary w-100">Gửi link đặt lại mật khẩu</button>
                <div class="mt-3 text-center">
                    <a asp-page="/Account/Login" class="text-decoration-none">Quay lại đăng nhập</a>
                </div>
            </form>
        </div>
    </div>
</div> 