@page
@model OneTouch.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h3 class="text-center">Quên mật khẩu</h3>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger">@Model.ErrorMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                    {
                        <div class="alert alert-success">@Model.SuccessMessage</div>
                    }

                    <form method="post">
                        <div class="form-group mb-3">
                            <label class="form-label">Chọn phương thức xác thực:</label>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="Input.VerificationMethod" id="emailMethod" value="email" checked>
                                <label class="form-check-label" for="emailMethod">
                                    Xác thực qua Email
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="Input.VerificationMethod" id="phoneMethod" value="phone">
                                <label class="form-check-label" for="phoneMethod">
                                    Xác thực qua Số điện thoại
                                </label>
                            </div>
                        </div>

                        <div id="emailInput" class="form-group mb-3">
                            <label asp-for="Input.Email" class="form-label">Email</label>
                            <input asp-for="Input.Email" class="form-control" placeholder="Nhập email của bạn" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div id="phoneInput" class="form-group mb-3" style="display: none;">
                            <label asp-for="Input.Phone" class="form-label">Số điện thoại</label>
                            <input asp-for="Input.Phone" class="form-control" placeholder="Nhập số điện thoại của bạn" />
                            <span asp-validation-for="Input.Phone" class="text-danger"></span>
                        </div>

                        <div class="form-group text-center">
                            <button type="submit" class="btn btn-primary">Gửi yêu cầu</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('input[name="Input.VerificationMethod"]').change(function () {
                if ($(this).val() === 'email') {
                    $('#emailInput').show();
                    $('#phoneInput').hide();
                } else {
                    $('#emailInput').hide();
                    $('#phoneInput').show();
                }
            });
        });
    </script>
} 