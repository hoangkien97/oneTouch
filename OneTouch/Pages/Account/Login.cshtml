@page
@model OneTouch.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <h2 class="mb-4 text-center">Đăng nhập</h2>
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            <form method="post">
                <div class="mb-3">
                    <label for="phone" class="form-label">Số điện thoại</label>
                    <input asp-for="Input.Phone" class="form-control" id="phone" required />
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Mật khẩu</label>
                    <input asp-for="Input.Password" class="form-control" id="password" type="password" required />
                </div>
                <div class="mb-3 text-end">
                    <a asp-page="/Account/ForgotPassword" class="text-decoration-none">Quên mật khẩu?</a>
                </div>
                <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
            </form>
        </div>
    </div>
</div>