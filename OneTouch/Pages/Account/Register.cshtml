@page
@model OneTouch.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <h2 class="mb-4 text-center">Đăng ký tài khoản</h2>
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            <form method="post">
                <div class="mb-3">
                    <label for="fullname" class="form-label">Họ tên</label>
                    <input asp-for="Input.FullName" class="form-control" id="fullname" required />
                </div>
                <div class="mb-3">
                    <label for="phone" class="form-label">Số điện thoại</label>
                    <input asp-for="Input.Phone" class="form-control" id="phone" required />
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email (không bắt buộc)</label>
                    <input asp-for="Input.Email" class="form-control" id="email" />
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Mật khẩu</label>
                    <input asp-for="Input.Password" class="form-control" id="password" type="password" required />
                </div>
                <button type="submit" class="btn btn-primary w-100">Đăng ký</button>
            </form>
        </div>
    </div>
</div> 