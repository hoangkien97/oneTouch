@page
@model OneTouch.Pages.Account.ResetPasswordWithOtpModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <h2 class="mb-4 text-center">Đặt lại mật khẩu</h2>
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success">
                    @Model.SuccessMessage
                    <div class="mt-3 text-center">
                        <a asp-page="/Account/Login" class="btn btn-primary">Đăng nhập</a>
                    </div>
                </div>
            }
            else
            {
                <form method="post" id="resetPasswordForm">
                    <input type="hidden" asp-for="Input.Phone" />
                    <input type="hidden" asp-for="Input.Token" />
                    <div class="mb-3">
                        <label for="password" class="form-label">Mật khẩu mới</label>
                        <input asp-for="Input.NewPassword" class="form-control" id="password" type="password" required />
                        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label">Xác nhận mật khẩu</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" id="confirmPassword" type="password" required />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Đặt lại mật khẩu</button>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Ngăn chặn chuyển hướng tự động
        window.onload = function() {
            if (document.querySelector('.alert-success')) {
                // Nếu có thông báo thành công, ẩn form
                document.getElementById('resetPasswordForm')?.style.display = 'none';
            }
        }
    </script>
} 