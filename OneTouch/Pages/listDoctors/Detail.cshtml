@page "{doctorId:int}"
@model OneTouch.Pages.listDoctors.DetailModel
@{
    ViewData["Title"] = "Chi tiết Bác sĩ";
}

<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-md-4 text-center">
                <img src="@(!string.IsNullOrEmpty(Model.Doctor.AvatarPath) ? Model.Doctor.AvatarPath : "/uploads/doctor/default-avatar.png")" class="img-fluid rounded-circle mb-3" style="width: 180px; height: 180px; object-fit: cover;">
                <h2 class="fw-bold">@Model.Doctor.FullName</h2>
                <h5 class="text-primary">@Model.Doctor.SpecialtyName</h5>
                <div class="d-flex justify-content-center align-items-center my-2">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="fa-solid fa-star @(i <= Model.Doctor.AverageRating ? "text-warning" : "text-light")"></i>
                    }
                    <span class="ms-2 text-muted">(@Model.Doctor.AverageRating.ToString("0.0"))</span>
                </div>
                <div class="mb-2">
                    <span class="badge bg-info">@Model.Doctor.TotalAppointments lượt khám</span>
                </div>
                <a href="/Appointments/Create?doctorId=@Model.Doctor.DoctorId" class="btn btn-primary mt-3">
                    <i class="fas fa-calendar-plus me-2"></i>Đặt lịch khám ngay
                </a>
            </div>
            <div class="col-md-8">
                <h4 class="mb-3">Giới thiệu</h4>
                <p>@Model.Doctor.Description</p>
                <h4 class="mt-4 mb-3">Phản hồi của bệnh nhân</h4>
                @if (Model.Feedbacks != null && Model.Feedbacks.Any())
                {
                    <div class="list-group">
                        @foreach (var fb in Model.Feedbacks)
                        {
                            <div class="list-group-item mb-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@fb.PatientName</strong>
                                        <span class="ms-2 text-warning">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="fa-solid fa-star @(i <= fb.Rating ? "text-warning" : "text-light")"></i>
                                            }
                                        </span>
                                    </div>
                                    <span class="text-muted small">@fb.CreatedAt.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="mt-2">@fb.Comment</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p>Chưa có phản hồi nào.</p>
                }
            </div>
        </div>
    </div>
</section> 