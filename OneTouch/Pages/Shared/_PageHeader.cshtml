@model dynamic
@functions {
    bool HasProperty(dynamic obj, string name)
    {
        if (obj == null) return false;
        if (obj is IDictionary<string, object> dict)
        {
            return dict.ContainsKey(name);
        }
        return obj.GetType().GetProperty(name) != null;
    }
}

<div class="page-header bg-primary text-white py-5 mb-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="@(HasProperty(Model, "ImageUrl") && !string.IsNullOrEmpty(Model.ImageUrl) ? "col-lg-6" : "col-12 text-center")">
                <h1 class="display-4 fw-bold mb-3">@Model.Title</h1>
                @if (HasProperty(Model, "Subtitle") && !string.IsNullOrEmpty(Model.Subtitle))
                {
                    <p class="lead mb-0">@Model.Subtitle</p>
                }
            </div>
            @if (HasProperty(Model, "ImageUrl") && !string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="col-lg-6">
                    <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded-3 shadow-lg">
                </div>
            }
        </div>
    </div>
</div> 