@model OneTouch.Models.Doctor

<div class="doctor-card hover-shadow">
    <img src="@(Model.AvatarPath ?? "/images/doctor-default.jpg")" alt="@Model.User.FullName" class="img-fluid">
    <div class="card-body text-center">
        <h4 class="h5 mb-2">@Model.User.FullName</h4>
        <p class="text-muted mb-3">@Model.Specialty</p>
        <div class="doctor-social">
            <a href="#" class="hover-scale"><i class="fab fa-facebook-f"></i></a>
            <a href="#" class="hover-scale"><i class="fab fa-twitter"></i></a>
            <a href="#" class="hover-scale"><i class="fab fa-linkedin-in"></i></a>
        </div>
        <a href="/Appointments/Create?doctorId=@Model.DoctorId" class="btn btn-primary mt-3">
            <i class="fas fa-calendar-plus me-2"></i>Đặt lịch khám
        </a>
    </div>
</div> 