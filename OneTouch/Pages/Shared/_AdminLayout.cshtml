<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OneTouch.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            background: #f8f9fa;
        }
        
        .admin-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            width: 250px;
            background: #2c3e50;
            z-index: 1000;
            transition: all 0.3s ease;
        }
        
        .admin-sidebar-header {
            padding: 1.5rem;
            border-bottom: 1px solid #34495e;
            text-align: center;
        }
        
        .admin-sidebar-brand {
            color: white;
            font-size: 1.5rem;
            font-weight: 700;
            text-decoration: none;
        }
        
        .admin-sidebar-brand:hover {
            color: #3498db;
            text-decoration: none;
        }
        
        .admin-nav {
            padding: 1rem 0;
        }
        
        .admin-nav-item {
            display: block;
            padding: 0.75rem 1.5rem;
            color: #bdc3c7;
            text-decoration: none;
            transition: all 0.3s ease;
            border-left: 3px solid transparent;
        }
        
        .admin-nav-item:hover {
            background: #34495e;
            color: white;
            border-left-color: #3498db;
            text-decoration: none;
        }
        
        .admin-nav-item.active {
            background: #34495e;
            color: white;
            border-left-color: #3498db;
        }
        
        .admin-nav-item i {
            width: 20px;
            margin-right: 0.5rem;
        }
        
        .admin-main {
            margin-left: 250px;
            min-height: 100vh;
            transition: all 0.3s ease;
        }
        
        .admin-topbar {
            background: white;
            border-bottom: 1px solid #e9ecef;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .admin-content {
            padding: 2rem;
        }
        
        .admin-user-menu {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        
        .admin-user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #3498db;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
        }
        
        @@media (max-width: 768px) {
            .admin-sidebar {
                transform: translateX(-100%);
            }
            
            .admin-sidebar.show {
                transform: translateX(0);
            }
            
            .admin-main {
                margin-left: 0;
            }
            
            .admin-toggle {
                display: block;
            }
        }
        
        .admin-toggle {
            display: none;
            background: none;
            border: none;
            font-size: 1.5rem;
            color: #2c3e50;
        }
    </style>
</head>
<body>
    <!-- Admin Sidebar -->
    <div class="admin-sidebar" id="adminSidebar">
        <div class="admin-sidebar-header">
            <a href="/Admin/Dashboard" class="admin-sidebar-brand">
                <i class="fas fa-user-shield me-2"></i>
                Admin Panel
            </a>
        </div>
        <nav class="admin-nav">
            <a href="/Admin/Dashboard" class="admin-nav-item @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("Dashboard") == true ? "active" : "")">
                <i class="fas fa-tachometer-alt"></i>
                Dashboard
            </a>
            <a href="/AppointmentManager" class="admin-nav-item @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("AppointmentManager") == true ? "active" : "")">
                <i class="fas fa-calendar-check"></i>
                Quản lý lịch hẹn
            </a>
            <a href="/DoctorManager" class="admin-nav-item @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("DoctorManager") == true ? "active" : "")">
                <i class="fas fa-user-md"></i>
                Quản lý bác sĩ
            </a>
            <a href="/ScheduleManager" class="admin-nav-item @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("ScheduleManager") == true ? "active" : "")">
                <i class="fas fa-clock"></i>
                Quản lý lịch làm việc
            </a>
            <a href="/MedicalRecordManager" class="admin-nav-item @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("MedicalRecordManager") == true ? "active" : "")">
                <i class="fas fa-file-medical"></i>
                Quản lý hồ sơ bệnh án
            </a>
            <a href="/Admin/Images" class="admin-nav-item @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("Images") == true ? "active" : "")">
                <i class="fas fa-images"></i>
                Quản lý hình ảnh
            </a>
            <hr class="my-3 border-secondary">
            <a href="/Admin/Dashboard" class="admin-nav-item">
                <i class="fas fa-home"></i>
                Về trang chủ
            </a>
            <a href="/Account/Logout" class="admin-nav-item text-danger">
                <i class="fas fa-sign-out-alt"></i>
                Đăng xuất
            </a>
        </nav>
    </div>

    <!-- Admin Main Content -->
    <div class="admin-main">
        <!-- Top Bar -->
        <div class="admin-topbar">
            <div class="d-flex align-items-center">
                <button class="admin-toggle me-3" id="sidebarToggle">
                    <i class="fas fa-bars"></i>
                </button>
                <h4 class="mb-0">@ViewData["Title"]</h4>
            </div>
            <div class="admin-user-menu">
                <span class="text-muted">Xin chào, @(Context.Session.GetString("UserName") ?? "Admin")</span>
                <div class="admin-user-avatar">
                    <i class="fas fa-user"></i>
                </div>
            </div>
        </div>

        <!-- Content -->
        <div class="admin-content">
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // Toggle sidebar on mobile
        document.getElementById('sidebarToggle').addEventListener('click', function() {
            document.getElementById('adminSidebar').classList.toggle('show');
        });
        
        // Close sidebar when clicking outside on mobile
        document.addEventListener('click', function(e) {
            const sidebar = document.getElementById('adminSidebar');
            const toggle = document.getElementById('sidebarToggle');
            
            if (window.innerWidth <= 768 && 
                !sidebar.contains(e.target) && 
                !toggle.contains(e.target)) {
                sidebar.classList.remove('show');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html> 