@page
@model OneTouch.Pages.Appointments.CreateModel
@{
    ViewData["Title"] = "Đặt lịch khám";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="card-title mb-4">Đặt lịch khám</h2>

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @Model.ErrorMessage
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                    {
                        <div class="alert alert-success" role="alert">
                            @Model.SuccessMessage
                        </div>
                    }

                    <form method="post" id="appointmentForm">
                        <div class="mb-4">
                            <label class="form-label">Chọn ngày khám</label>
                            <input type="date" id="dateSelect" class="form-control" min="@DateTime.Now.ToString("yyyy-MM-dd")" onchange="onDateChange()" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Chọn giờ khám</label>
                            <div id="timeSlots" class="row g-2">
                                <!-- Time slots will be loaded here -->
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.Note" class="form-label">Ghi chú</label>
                            <textarea asp-for="Input.Note" class="form-control" rows="3" placeholder="Nhập ghi chú (nếu có)"></textarea>
                        </div>

                        <input type="hidden" asp-for="Input.ScheduleId" id="selectedScheduleId" />

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary" id="submitBtn" disabled>Đặt lịch</button>
                            <a href="/User/Home" class="btn btn-outline-secondary">Quay lại trang chủ</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let schedules = [];

        async function onDateChange() {
            const date = document.getElementById('dateSelect').value;
            document.getElementById('timeSlots').innerHTML = '';
            document.getElementById('selectedScheduleId').value = '';
            document.getElementById('submitBtn').disabled = true;

            if (!date) {
                return;
            }

            try {
                const response = await fetch(`/api/schedules?date=${date}`);
                if (!response.ok) {
                    throw new Error('Failed to load schedules');
                }
                schedules = await response.json();
                const timeSlots = document.getElementById('timeSlots');
                timeSlots.innerHTML = '';
                if (schedules.length === 0) {
                    timeSlots.innerHTML = '<div class="col-12"><div class="alert alert-info">Không có lịch khám trong ngày này</div></div>';
                    return;
                }
                schedules.forEach(schedule => {
                    const slot = document.createElement('div');
                    slot.className = 'col-md-4';
                    const isAvailable = schedule.currentPatients < schedule.maxPatients;
                    const buttonClass = isAvailable ? 'btn-outline-primary' : 'btn-outline-secondary';
                    const disabled = isAvailable ? '' : 'disabled';
                    slot.innerHTML = `
                        <button type="button" class="btn ${buttonClass} w-100" ${disabled}
                                onclick="selectTimeSlot(${schedule.scheduleId})">
                            ${schedule.startTime} - ${schedule.endTime}
                            <br>
                            <small>${schedule.currentPatients}/${schedule.maxPatients} bệnh nhân</small>
                        </button>
                    `;
                    timeSlots.appendChild(slot);
                });
            } catch (error) {
                console.error('Error loading schedules:', error);
                document.getElementById('timeSlots').innerHTML = '<div class="col-12"><div class="alert alert-danger">Lỗi khi tải lịch khám</div></div>';
            }
        }

        function selectTimeSlot(scheduleId) {
            document.getElementById('selectedScheduleId').value = scheduleId;
            document.getElementById('submitBtn').disabled = false;
            // Highlight selected slot
            const buttons = document.querySelectorAll('#timeSlots button');
            buttons.forEach(button => {
                button.classList.remove('btn-primary');
                button.classList.add('btn-outline-primary');
            });
            event.target.classList.remove('btn-outline-primary');
            event.target.classList.add('btn-primary');
        }
    </script>
} 