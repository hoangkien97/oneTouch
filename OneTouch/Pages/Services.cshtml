@page
@model OneTouch.Pages.ServicesModel
@{
    ViewData["Title"] = "Dịch vụ";
}

@await Html.PartialAsync("_PageHeader", new { 
    Title = "Dịch vụ y tế", 
    Subtitle = "Khám phá các dịch vụ chăm sóc sức khỏe chất lượng cao của chúng tôi"
})

<!-- Services Section -->
<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4">
                @await Html.PartialAsync("_ServiceCard", new {
                    Icon = "fas fa-stethoscope",
                    Title = "Khám tổng quát",
                    Description = "Dịch vụ khám sức khỏe tổng quát toàn diện, giúp phát hiện sớm các vấn đề sức khỏe.",
                    ButtonUrl = "/Appointments/Create",
                    ButtonText = "Đặt lịch khám"
                })
            </div>
            <div class="col-lg-4">
                @await Html.PartialAsync("_ServiceCard", new {
                    Icon = "fas fa-heartbeat",
                    Title = "Khám chuyên khoa",
                    Description = "Đội ngũ bác sĩ chuyên khoa giàu kinh nghiệm, trang thiết bị hiện đại.",
                    ButtonUrl = "/Specialties",
                    ButtonText = "Chọn chuyên khoa"
                })
            </div>
            <div class="col-lg-4">
                @await Html.PartialAsync("_ServiceCard", new {
                    Icon = "fas fa-procedures",
                    Title = "Cấp cứu 24/7",
                    Description = "Dịch vụ cấp cứu 24/7 với đội ngũ y bác sĩ luôn sẵn sàng trong mọi tình huống.",
                    ButtonUrl = "#",
                    ButtonText = "Tìm hiểu thêm"
                })
            </div>
            <div class="col-lg-4">
                @await Html.PartialAsync("_ServiceCard", new {
                    Icon = "fas fa-microscope",
                    Title = "Xét nghiệm",
                    Description = "Dịch vụ xét nghiệm đa dạng với trang thiết bị hiện đại, kết quả nhanh chóng và chính xác.",
                    ButtonUrl = "#",
                    ButtonText = "Tìm hiểu thêm"
                })
            </div>
            <div class="col-lg-4">
                @await Html.PartialAsync("_ServiceCard", new {
                    Icon = "fas fa-x-ray",
                    Title = "Chẩn đoán hình ảnh",
                    Description = "Các dịch vụ chẩn đoán hình ảnh hiện đại như X-quang, CT, MRI với độ chính xác cao.",
                    ButtonUrl = "#",
                    ButtonText = "Tìm hiểu thêm"
                })
            </div>
            <div class="col-lg-4">
                @await Html.PartialAsync("_ServiceCard", new {
                    Icon = "fas fa-pills",
                    Title = "Nhà thuốc",
                    Description = "Nhà thuốc cung cấp đầy đủ các loại thuốc với đội ngũ dược sĩ tư vấn chuyên nghiệp.",
                    ButtonUrl = "#",
                    ButtonText = "Tìm hiểu thêm"
                })
            </div>
        </div>
    </div>
</section>

<!-- Why Choose Us Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <img src="/uploads/about/43c67ab8-f66f-4253-83fb-2905386added.jpg" alt="Why Choose Us" class="img-fluid rounded-3 shadow">
            </div>
            <div class="col-lg-6">
                <span class="badge bg-primary mb-3 px-3 py-2">Tại sao chọn chúng tôi?</span>
                <h2 class="h1 mb-4">Chăm sóc sức khỏe chất lượng cao</h2>
                <div class="d-flex mb-4">
                    <div class="me-4">
                        <div class="feature-icon">
                            <i class="fas fa-user-md"></i>
                        </div>
                    </div>
                    <div>
                        <h4 class="h5 mb-3">Đội ngũ y bác sĩ giàu kinh nghiệm</h4>
                        <p class="text-muted mb-0">Các bác sĩ của chúng tôi đều có nhiều năm kinh nghiệm và chuyên môn cao trong lĩnh vực của mình.</p>
                    </div>
                </div>
                <div class="d-flex mb-4">
                    <div class="me-4">
                        <div class="feature-icon">
                            <i class="fas fa-hospital"></i>
                        </div>
                    </div>
                    <div>
                        <h4 class="h5 mb-3">Cơ sở vật chất hiện đại</h4>
                        <p class="text-muted mb-0">Trang thiết bị y tế hiện đại, đạt chuẩn quốc tế, đảm bảo chất lượng điều trị tốt nhất.</p>
                    </div>
                </div>
                <div class="d-flex">
                    <div class="me-4">
                        <div class="feature-icon">
                            <i class="fas fa-headset"></i>
                        </div>
                    </div>
                    <div>
                        <h4 class="h5 mb-3">Chăm sóc tận tâm</h4>
                        <p class="text-muted mb-0">Đội ngũ nhân viên thân thiện, tận tâm, luôn sẵn sàng hỗ trợ bạn 24/7.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Add smooth scrolling
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                document.querySelector(this.getAttribute('href')).scrollIntoView({
                    behavior: 'smooth'
                });
            });
        });
    </script>
} 