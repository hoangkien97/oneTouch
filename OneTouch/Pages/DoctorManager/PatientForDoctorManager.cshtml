@page "{doctorId:int}"
@model OneTouch.Pages.DoctorManager.PatientForDoctorManagerModel
@{
    ViewData["Title"] = "Danh sách Bệnh nhân";
}

<style>
    .sidebar {
        position: fixed;
        top: 56px;
        left: 0;
        width: 240px;
        height: calc(100vh - 56px);
        background-color: #ffffff;
        padding: 20px;
        border-right: 1px solid #dee2e6;
        box-shadow: 2px 0 5px rgba(0, 0, 0, 0.05);
        z-index: 1000;
    }

    .main-content {
        margin-left: 260px;
        padding: 40px 30px;
        background-color: #f8f9fa;
        min-height: 100vh;
    }

    .table th,
    .table td {
        vertical-align: middle;
    }

    .table th {
        background-color: #f1f1f1;
    }

    .pagination .page-item.active .page-link {
        background-color: #0d6efd;
        border-color: #0d6efd;
        color: white;
    }

    .pagination .page-link {
        color: #0d6efd;
    }

    .btn-sm {
        font-size: 0.875rem;
        padding: 0.25rem 0.5rem;
    }
</style>

<!-- Sidebar -->
<div class="sidebar">
    <h4 class="text-primary">📋 Chức năng</h4>
    <ul class="nav flex-column">
        <li class="nav-item mb-2">
            <a class="btn btn-outline-primary w-100" asp-page="/DoctorManager/DoctorDashboard" asp-route-doctorId="@Model.DoctorId">🏠 Trang chính</a>
        </li>
        <li class="nav-item mb-2">
            <a class="btn btn-outline-secondary w-100" asp-page="/ScheduleManager/WeeklyView" asp-route-doctorId="@Model.DoctorId">📅 Lịch theo tuần</a>
        </li>
        <li class="nav-item mb-2">
            <a class="btn btn-outline-info w-100" asp-page="/DoctorManager/PatientForDoctorManager" asp-route-doctorId="@Model.DoctorId">🧑‍🤝‍🧑 Bệnh nhân</a>
        </li>
        <li class="nav-item mb-2">
            <a class="btn btn-outline-success w-100" asp-page="/MedicalRecordManager/Create">💊 Tạo đơn thuốc</a>
        </li>
    </ul>
</div>

<!-- Main content -->
<div class="main-content">
    <h2 class="text-primary mb-4">🧑‍⚕️ Danh sách Bệnh nhân của Bác sĩ #@Model.DoctorId</h2>

    <form method="get" class="input-group mb-4">
        <input type="hidden" name="doctorId" value="@Model.DoctorId" />
        <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="🔍 Tìm theo tên hoặc SĐT..." />
        <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
    </form>

    @if (!Model.Patients.Any())
    {
        <div class="alert alert-info">Chưa có bệnh nhân nào khám với bác sĩ này.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover shadow-sm bg-white rounded">
                <thead class="table-light">
                    <tr>
                        <th>👤 Họ tên</th>
                        <th>📧 Email</th>
                        <th>📞 Số điện thoại</th>
                        <th class="text-center">🔧 Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in Model.Patients)
                    {
                        <tr>
                            <td>@patient.FullName</td>
                            <td>@patient.Email</td>
                            <td>@patient.Phone</td>
                            <td class="text-center">
                                <a class="btn btn-sm btn-outline-info me-1"
                                   asp-page="/MedicalRecordManager/Index"
                                   asp-route-userId="@patient.UserId">
                                    📄 Hồ sơ
                                </a>
                                <a class="btn btn-sm btn-outline-success"
                                   asp-page="/MedicalRecordManager/Create"
                                   asp-route-userId="@patient.UserId">
                                    💊 Tạo đơn
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PHÂN TRANG -->
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-page="/DoctorManager/PatientForDoctorManager"
                           asp-route-doctorId="@Model.DoctorId"
                           asp-route-Page="@i"
                           asp-route-SearchTerm="@Model.SearchTerm">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
