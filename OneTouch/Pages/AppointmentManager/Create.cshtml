@page
@model OneTouch.Pages.AppointmentManager.CreateModel
@{
    ViewData["Title"] = "Create Appointment";
}

<h1 class="mb-4">Create Appointment</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post" class="border p-4 shadow-sm rounded bg-light">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Appointment.ScheduleId" class="form-label">Choose Schedule</label>
                <select asp-for="Appointment.ScheduleId" class="form-select" asp-items="ViewBag.Schedules"></select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Appointment.UserId" class="form-label">Select User</label>
                <select asp-for="Appointment.UserId" class="form-select" asp-items="ViewBag.Users"></select>
            </div>

            <!-- Optional: You can remove the status input or make it hidden -->
            <input asp-for="Appointment.Status" value="Pending" type="hidden" />

            <div class="form-group mb-3">
                <label asp-for="Appointment.Note" class="form-label">Note</label>
                <textarea asp-for="Appointment.Note" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Appointment.Note" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary w-100">Create Appointment</button>
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="Index" class="btn btn-link">← Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
