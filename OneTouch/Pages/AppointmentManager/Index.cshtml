@page
@model OneTouch.Pages.AppointmentManager.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý lịch hẹn";
}

<h1>Quản lý lịch hẹn</h1>

<!-- <p>
    <a asp-page="Create" class="btn btn-primary">Create New</a>
</p> -->

<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered align-middle shadow-sm" style="border-radius: 12px; overflow: hidden;">
        <thead class="table-primary">
            <tr>
                <th>Status</th>
                <th>CreatedAt</th>
                <th>Note</th>
                <th>Schedule</th>
                <th>User</th>
                <!-- <th></th> -->
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Appointment)
        {
            <tr>
                <td>@item.Status</td>
                <td>@item.CreatedAt</td>
                <td>@item.Note</td>
                    <td>
                        @(item.Schedule != null && item.Schedule.StartTime.HasValue && item.Schedule.EndTime.HasValue
                            ? $"{item.Schedule.StartTime.Value:hh:mm} - {item.Schedule.EndTime.Value:hh:mm}"
                            : "")
                    </td>
                <td>
                    @(item.User != null ? item.User.FullName : "")
                </td>
                <!--
                <td>
                    <a asp-page="Edit" asp-route-id="@item.AppointmentId">Edit</a> |
                    <a asp-page="Details" asp-route-id="@item.AppointmentId">Details</a> |
                    <a asp-page="Delete" asp-route-id="@item.AppointmentId">Delete</a>
                </td>
                -->
            </tr>
        }
        </tbody>
    </table>
</div>

<style>
.table {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
}
.table thead.table-primary {
    background: linear-gradient(90deg, #667eea 0%, #64b5f6 100%);
    color: #fff;
    font-weight: 600;
    border: none;
}
.table-striped > tbody > tr:nth-of-type(odd) {
    background-color: #f6f9fc;
}
.table-hover > tbody > tr:hover {
    background-color: #e3f2fd;
}
.table th, .table td {
    vertical-align: middle;
    border: none;
}
</style>